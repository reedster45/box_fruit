<%- include('partials/header') %>


<div class="main-container container">


    <div class="container-fluid d-flex justify-content-center align-items-center">
        <div class="stream-content text-center">
            <h1 class="py-3"><%= tvshow.name %></h1>
            <h1 class="pb-2">Episode <%= episode.episode_number %>: <%= episode.name %></h1>

            <iframe class="stream-glow mt-5 mb-5" src="<%= curr_src %>" title="<%= tvshow.name %>" width="900" height="500" frameborder="0" scrolling="no" allowfullscreen></iframe>

            <iframe class="stream-glow mt-5 mb-5" src="https://2anime.xyz/embed/one-piece-episode-346" width="900" height="500" frameborder="0" scrolling="no" allowfullscreen></iframe>
        </div>
    </div>

    <div class="d-flex justify-content-center py-3 px-5 w-100">
        <% sources.forEach((src, key) => { %>
            <a href="/streamtv/<%= tvshow.id %>/season/<%= season.season_number %>/episode/<%= episode.episode_number %>?key=<%= key %>" style="text-decoration: none;">
                <% if (key == curr_key) { %>
                    <div class="server-button" style="background-color: rgb(105, 105, 105);">
                        <p class="px-3 my-0 py-1"><%= key %></p>
                    </div>                    
                <% } else { %>
                    <div class="server-button">
                        <p class="px-3 my-0 py-1"><%= key %></p>
                    </div>
                <% } %>
            </a>
        <% }); %>
    </div>



    <!-- Display available seasons as links -->
    <div class="py-3">
        <select onchange="window.location.href=this.value">
        <% availableSeasons.forEach(s => { %>
            <option value="/tvshow/<%= tvshow.id %>/season/<%= s.season_number %>" <%= s.season_number === season.season_number ? 'selected' : '' %>>
                <%= s.name %>
            </option>           
        <% }); %>
        </select>
    </div>

    <!-- Display selected season's episodes -->
    <div class="episodes">
    <h3>Episodes (Season <%= season.season_number %>):</h3>
    <% season.episodes.forEach(episode => { %>
        <div class="episode">
        <h4>
            <a href="/streamtv/<%= tvshow.id %>/season/<%= season.season_number %>/episode/<%= episode.episode_number %>">
            Episode <%= episode.episode_number %>: <%= episode.name %>
            </a>
        </h4>
        <p><strong>Air Date:</strong> <%= episode.air_date %></p>
        <p><strong>Overview:</strong> <%= episode.overview %></p>
        </div>
    <% }); %>
    </div>

</div>


<%- include('partials/footer') %>